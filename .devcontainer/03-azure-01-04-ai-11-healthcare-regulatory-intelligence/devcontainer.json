{
  "name": "Azure / AI / Regulatory Intelligence",
  "build": {
    "dockerfile": "../../03-Azure/01-04-AI/11_Healthcare_Regulatory_Intelligence/.devcontainer/Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "installBicep": true
    },
    "ghcr.io/azure/azure-dev/azd:latest": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/03-Azure/01-04-AI/11_Healthcare_Regulatory_Intelligence",
  "remoteUser": "vscode",
  "waitFor": "postCreateCommand",
  "postCreateCommand": "uv sync --frozen --all-extras && uv run --frozen --all-extras pytest -q",
  "forwardPorts": [
    8088
  ],
  "portsAttributes": {
    "8088": {
      "label": "Regulatory Intelligence Assistant (local run)",
      "visibility": "private",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-bicep"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venvs/regintel/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.openRepositoryInParentFolders": "always"
      }
    }
  }
}
