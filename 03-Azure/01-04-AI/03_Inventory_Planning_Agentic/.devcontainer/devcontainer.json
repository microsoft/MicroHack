{
  // Used when ONLY this hack folder is opened in VS Code ("Dev Containers: Reopen in Container").
  // GitHub Codespaces and full-repo clones use the repo-root config instead:
  //   .devcontainer/03-azure-01-04-ai-03-inventory-planning-agentic/devcontainer.json
  // Keep both in sync.
  "name": "Azure / AI / Inventory Planning Agentic (hack folder)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/azure/azure-dev/azd:latest": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Planner Console", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode",
  // Python venv on a container volume — Docker Desktop bind mounts fail on venv-sized installs.
  "mounts": [
    "source=inv-agentic-venv-${devcontainerId},target=${containerWorkspaceFolder}/src/.venv,type=volume"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-azuretools.azure-dev",
        "ms-azuretools.vscode-azureresourcegroups",
        "ms-windows-ai-studio.windows-ai-studio",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/src/.venv/bin/python",
        "python.terminal.activateEnvironment": true
      }
    }
  },
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  }
}