# Copy this file to .env at the repository root, then replace required values
# with credentials supplied by the MicroHack platform or event coach.

# Microsoft Foundry project and models
AI_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
MODEL_DEPLOYMENT_NAME=gpt-5.4
FOUNDRY_MODEL=gpt-5.4
FOUNDRY_QUARANTINE_MODEL=gpt-5.4

# Mistral Document AI
MISTRAL_DOCUMENT_AI_ENDPOINT=https://<foundry-resource>.cognitiveservices.azure.com
MISTRAL_DOCUMENT_AI_KEY=<foundry-api-key>
MISTRAL_DOCUMENT_AI_DEPLOYMENT_NAME=mistral-document-ai-2512
MISTRAL_DOCUMENT_AI_API_VERSION=2024-05-01-preview

# Azure AI Search and Foundry IQ
FOUNDRY_IQ_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
FOUNDRY_IQ_SEARCH_KEY=<search-admin-key>
FOUNDRY_IQ_SEARCH_INDEX_NAME=crash-statements
FOUNDRY_IQ_KNOWLEDGE_SOURCE_NAME=crash-statements-ks
FOUNDRY_IQ_KNOWLEDGE_BASE_NAME=crash-statements-kb
SEARCH_SERVICE_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_ADMIN_KEY=<search-admin-key>

# Azure Storage policy documents
AZURE_STORAGE_CONNECTION_STRING=<storage-connection-string>
AZURE_POLICIES_CONTAINER_NAME=policies

# Sequential workflow
HUMAN_REVIEW_CONFIDENCE_THRESHOLD=0.9
