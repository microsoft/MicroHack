# ---------------------------------------------------------------------------
# MicroHack: AI Governance — notebook configuration
#
# Copy this file to `.env` in this same folder, then fill in the values.
# Your lab is already deployed -- do NOT run `azd up`.
#
# Full step-by-step instructions, including how to sign in to Azure and how to
# find the <TOKEN> used in most of these names, are in challenge-01.md Part A.
#
# The notebooks read os.environ first, so this is all you need -- `azd` is NOT
# required.
#
#     cp .env.template .env
#
# `.env` is gitignored, so your values will not be committed.
#
# (If you prefer the original azd workflow, leave this file alone and run
#  labautomation/setup-notebook-env.ps1 instead — the notebooks fall back to
#  `azd env get-value` when a key is not present here.)
# ---------------------------------------------------------------------------

# ===== Required for challenges 1-6 (core) ==================================
# Dashboard credential: Resource Group Name (e.g. rg-labuser-0005)
AZURE_RESOURCE_GROUP=

# Portal: your resource group's Overview blade. Use the compact form, e.g.
# 'swedencentral' -- not 'Sweden Central'.
AZURE_LOCATION=

# Dashboard credential: Subscription ID
AZURE_SUBSCRIPTION_ID=

# See challenge-01.md, Part A.4 for the value to paste here.
# One long line of JSON. It must be a SINGLE line, with no surrounding quotes,
# and it must end with }]}] -- four closing brackets. A missing final bracket is
# the most common setup error and produces a confusing parse error.
# Validate it with the snippet in challenge-01.md Part A.5 before you start.
LLM_BACKEND_CONFIG=

# ===== Required for challenges 3, 4 and 7 ==================================
# Same value as AZURE_RESOURCE_GROUP -- this lab uses a single resource group.
SPOKE_RESOURCE_GROUP=

# kv-spoke-<TOKEN>   (see challenge-01.md Part A.2 for how to find <TOKEN>)
SPOKE_KEY_VAULT_NAME=

# aif-spoke-<TOKEN>
SPOKE_AI_FOUNDRY_ACCOUNT_NAME=

# Fixed value, no token: citadel-agents-project
SPOKE_AI_FOUNDRY_PROJECT_NAME=

# ===== Required for challenge 7 ============================================
# acrcitadel<TOKEN>
SPOKE_ACR_NAME=

# acrcitadel<TOKEN>.azurecr.io
SPOKE_ACR_LOGIN_SERVER=

# ===== Required for challenge 8 ============================================
# aif-spoke-<TOKEN> -- the Foundry account that hosts the agent. Set this
# explicitly: challenge 8 otherwise looks for a backend id ending in "-0",
# which this lab's resource naming does not produce.
A2A_FOUNDRY_ACCOUNT_NAME=

# ===== Challenge 9 (optional / instructor-led) =============================
# Not produced by this lab's automation — your facilitator will provide these
# only if challenge 9 is being run.
HR_MCP_ACCESS_TOKEN=
HR_MCP_APIM_SUBSCRIPTION_KEY=
