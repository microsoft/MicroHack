      "targets": [
        {
          "azureLogAnalytics": {
            "dashboardTime": true,
            "query": "customMetrics\n| where name startswith \"fraud.\"\n| summarize ['Transactions Processed'] = sumif(valueSum, name == \"fraud.transactions.processed\"), ['Classifications'] = sumif(valueSum, name == \"fraud.workflow.classifications\"), ['Alerts'] = sumif(valueSum, name == \"fraud.alert.status\"), ['Extraction Failures'] = sumif(valueSum, name == \"fraud.metrics.extraction_failures\")",
