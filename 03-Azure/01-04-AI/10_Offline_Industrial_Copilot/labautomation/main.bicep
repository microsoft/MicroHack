targetScope = 'resourceGroup'

@description('Azure region for all resources.')
param location string = resourceGroup().location

@description('Short unique suffix used in resource names.')
@minLength(4)
@maxLength(12)
param resourceSuffix string

@description('Deploy a Windows 11 VM that participants can use instead of their own laptop.')
param deployVm bool = true

@description('VM size. Foundry Local runs on the CPU of this size. Pick a GPU size for faster answers.')
param vmSize string = 'Standard_D8s_v5'

@description('VM administrator user name.')
param vmAdminUser string = 'labadmin'

@secure()
@description('VM administrator password. Generated by deploy-lab.ps1.')
param vmAdminPassword string = ''

var tags = {
  CostControl: 'Ignore'
  SecurityControl: 'Ignore'
  lab: 'offline-industrial-copilot'
}
var storageName = toLower('stoic${resourceSuffix}')
var keyVaultName = toLower('kv-oic-${resourceSuffix}')
var workspaceName = 'mlw-oic-${resourceSuffix}'
var vmName = 'vm-oic-${take(resourceSuffix, 8)}'

// ---------- Azure Machine Learning workspace (Challenge 5: train in the cloud) ----------

resource storage 'Microsoft.Storage/storageAccounts@2023-05-01' = {
  name: take(storageName, 24)
  location: location
  tags: tags
  sku: { name: 'Standard_LRS' }
  kind: 'StorageV2'
  properties: {
    minimumTlsVersion: 'TLS1_2'
    allowBlobPublicAccess: false
  }
}

resource keyVault 'Microsoft.KeyVault/vaults@2023-07-01' = {
  name: take(keyVaultName, 24)
  location: location
  tags: tags
  properties: {
    tenantId: subscription().tenantId
    sku: { family: 'A', name: 'standard' }
    enableRbacAuthorization: true
  }
}

resource logs 'Microsoft.OperationalInsights/workspaces@2023-09-01' = {
  name: 'log-oic-${resourceSuffix}'
  location: location
  tags: tags
  properties: {
    sku: { name: 'PerGB2018' }
    retentionInDays: 30
  }
}

resource appInsights 'Microsoft.Insights/components@2020-02-02' = {
  name: 'appi-oic-${resourceSuffix}'
  location: location
  tags: tags
  kind: 'web'
  properties: {
    Application_Type: 'web'
    WorkspaceResourceId: logs.id
  }
}

resource mlWorkspace 'Microsoft.MachineLearningServices/workspaces@2024-10-01' = {
  name: workspaceName
  location: location
  tags: tags
  identity: { type: 'SystemAssigned' }
  properties: {
    friendlyName: 'Offline Industrial Copilot'
    storageAccount: storage.id
    keyVault: keyVault.id
    applicationInsights: appInsights.id
  }
}

// ---------- Optional Windows 11 VM (alternative to a laptop) ----------

resource nsg 'Microsoft.Network/networkSecurityGroups@2024-05-01' = if (deployVm) {
  name: 'nsg-oic-${resourceSuffix}'
  location: location
  tags: tags
  properties: {
    securityRules: [
      {
        name: 'allow-rdp'
        properties: {
          priority: 1000
          direction: 'Inbound'
          access: 'Allow'
          protocol: 'Tcp'
          sourceAddressPrefix: '*'
          sourcePortRange: '*'
          destinationAddressPrefix: '*'
          destinationPortRange: '3389'
        }
      }
    ]
  }
}

resource vnet 'Microsoft.Network/virtualNetworks@2024-05-01' = if (deployVm) {
  name: 'vnet-oic-${resourceSuffix}'
  location: location
  tags: tags
  properties: {
    addressSpace: { addressPrefixes: ['10.20.0.0/24'] }
    subnets: [
      {
        name: 'vm'
        properties: {
          addressPrefix: '10.20.0.0/24'
          networkSecurityGroup: { id: nsg.id }
        }
      }
    ]
  }
}

resource publicIp 'Microsoft.Network/publicIPAddresses@2024-05-01' = if (deployVm) {
  name: 'pip-oic-${resourceSuffix}'
  location: location
  tags: tags
  sku: { name: 'Standard' }
  properties: { publicIPAllocationMethod: 'Static' }
}

resource nic 'Microsoft.Network/networkInterfaces@2024-05-01' = if (deployVm) {
  name: 'nic-oic-${resourceSuffix}'
  location: location
  tags: tags
  properties: {
    ipConfigurations: [
      {
        name: 'ipconfig1'
        properties: {
          privateIPAllocationMethod: 'Dynamic'
          subnet: { id: '${vnet.id}/subnets/vm' }
          publicIPAddress: { id: publicIp.id }
        }
      }
    ]
  }
}

resource vm 'Microsoft.Compute/virtualMachines@2024-07-01' = if (deployVm) {
  name: vmName
  location: location
  tags: tags
  properties: {
    hardwareProfile: { vmSize: vmSize }
    licenseType: 'Windows_Client'
    osProfile: {
      computerName: take(vmName, 15)
      adminUsername: vmAdminUser
      adminPassword: vmAdminPassword
    }
    storageProfile: {
      imageReference: {
        publisher: 'MicrosoftWindowsDesktop'
        offer: 'windows-11'
        sku: 'win11-24h2-pro'
        version: 'latest'
      }
      osDisk: {
        createOption: 'FromImage'
        diskSizeGB: 128
        managedDisk: { storageAccountType: 'Premium_LRS' }
      }
    }
    networkProfile: { networkInterfaces: [{ id: nic.id }] }
  }
}

// Installs Python for all users and the Visual C++ runtime that Foundry Local needs. A fresh Windows image does not
// have the runtime, and the Foundry Local service then stops at start-up with "Unable to load DLL 'foundry_local'".
resource vmSetup 'Microsoft.Compute/virtualMachines/extensions@2024-07-01' = if (deployVm) {
  parent: vm
  name: 'setup-python'
  location: location
  properties: {
    publisher: 'Microsoft.Compute'
    type: 'CustomScriptExtension'
    typeHandlerVersion: '1.10'
    autoUpgradeMinorVersion: true
    protectedSettings: {
      commandToExecute: 'powershell -NoProfile -ExecutionPolicy Bypass -Command "$ProgressPreference=\'SilentlyContinue\'; Invoke-WebRequest -Uri https://www.python.org/ftp/python/3.12.8/python-3.12.8-amd64.exe -OutFile C:\\py.exe; Start-Process C:\\py.exe -ArgumentList \'/quiet InstallAllUsers=1 PrependPath=1\' -Wait; Remove-Item C:\\py.exe; Invoke-WebRequest -Uri https://aka.ms/vs/17/release/vc_redist.x64.exe -OutFile C:\\vc.exe; Start-Process C:\\vc.exe -ArgumentList \'/install /quiet /norestart\' -Wait; Remove-Item C:\\vc.exe"'
    }
  }
}

output mlWorkspaceName string = mlWorkspace.name
output vmName string = deployVm ? vmName : ''
output vmPublicIp string = deployVm ? publicIp!.properties.ipAddress : ''
output vmAdminUser string = deployVm ? vmAdminUser : ''
