# Copy this file to src/.env and fill in the values from your Hackbox (lab dashboard).
# .devcontainer/post-create.sh creates src/.env from this file for you.

# Microsoft-Decision-1.1 (dashboard: DecisionEndpoint, DecisionDeployment)
DECISION_ENDPOINT=https://dm-xxxxxxxxxxxx.services.ai.azure.com
DECISION_DEPLOYMENT=decision

# gpt-6-luna: Decisions API and the generative baseline (dashboard: OpenAIEndpoint, LunaDeployment)
OPENAI_ENDPOINT=https://dm-xxxxxxxxxxxx.openai.azure.com
LUNA_DEPLOYMENT=gpt-6-luna

# Challenge 6: the decision model used as the judge in Foundry evaluations. Leave empty to use
# DECISION_DEPLOYMENT (Microsoft-Decision-1.1).
JUDGE_DEPLOYMENT=

# Optional, Challenge 6: Foundry project endpoint (dashboard: FoundryProjectEndpoint) to log
# evaluation results to the project's Evaluations page.
PROJECT_ENDPOINT=

# How many requests the evaluator sends at the same time. Keep it low: your deployments
# are sized for one person, and everyone in the room shares the same Azure quota.
GATE_MAX_CONCURRENCY=2

# Capacity of your two deployments (Hackbox: DecisionCapacity, LunaCapacity). One unit =
# 1 request/min + 1,000 tokens/min. The client paces itself to stay under both limits.
DECISION_CAPACITY=500
LUNA_CAPACITY=40

# Prices used for cost estimates, in USD per 1 million tokens. These are NOT read from Azure.
# Microsoft-Decision-1.1 (Nov 2026): Global $0.042, US Data Zone $0.046, EU/APAC Data Zone $0.050,
# output free. Check the Azure pricing page for your region before you quote a number to anyone.
PRICE_DECISION_INPUT=0.05
PRICE_LUNA_DECISIONS_INPUT=0.10
PRICE_LUNA_RESPONSES_INPUT=0.10
PRICE_LUNA_RESPONSES_OUTPUT=0.50
